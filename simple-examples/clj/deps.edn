;; Simple deps.edn for running examples
{:paths     ["src" "resources"]
 :deps      {org.clojure/clojure {:mvn/version "1.12.0"}
             com.rpl/rama {:mvn/version "0.0.6-SNAPSHOT"}
             com.rpl/agent-o-rama {:mvn/version "0.9.0-SNAPSHOT"}
             dev.langchain4j/langchain4j-open-ai {:mvn/version "1.4.0"}
             dev.langchain4j/langchain4j-web-search-engine-tavily
             {:mvn/version "1.3.0-beta9"}

             org.apache.logging.log4j/log4j-slf4j18-impl {:mvn/version "2.16.0"}
             org.slf4j/slf4j-api {:mvn/version "1.8.0-beta4"}}
 :jvm-opts  ["-Xms2g" "-Xmx4g"]
 :aliases   {:test
             {:extra-paths ["test"]
              :extra-deps  {io.github.cognitect-labs/test-runner
                            {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
              :main-opts   ["-m" "cognitect.test-runner"]
              :exec-fn     cognitect.test-runner.api/test}}
 :mvn/repos
 {"nexus-public-releases"
  {:url "https://nexus.redplanetlabs.com/repository/maven-public-releases"}}}
