            (is (= :set (:action result)))
            (is (= "test-counter" (:counter result)))
            (is (= 42 (:value result)))))

        (testing "get operation retrieves stored value"
          (let [result (aor/agent-invoke agent
                                         {:counter-name "test-counter"
                                          :operation    :get})]
            (is (= :get (:action result)))
            (is (= "test-counter" (:counter result)))
