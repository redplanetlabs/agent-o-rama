          "contact" {"anyOf" [{"$ref" "#/$defs/address"} {"type" "null"}]}
          ;; 2020-12 tuple form:
          "scores"  {"type"        "array"
                     "prefixItems" [{"type" "number"}
                                    {"x-javaType" "java.lang.Double"}]
                     "items"       false}
          "prefs"   {"type" "object"
                     "patternProperties" {"^feature_[a-z]+$" {"type" "boolean"}}
                     "additionalProperties" false}}
