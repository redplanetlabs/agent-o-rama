        )))))

(defn matching-ascending-seq?
  ([items final-seq] (matching-ascending-seq? items final-seq <))
  ([items final-seq comp-fn]
   (and (apply comp-fn (mapv count items))
        (= final-seq (last items))
        (every?
         (fn [s]
           (= s (subvec final-seq 0 (count s))))
         items))))


