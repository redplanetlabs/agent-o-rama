(defrecord MockChatModel []
  ChatModel
  (doChat [this request]
    (let [^UserMessage m (-> request
                             .messages
                             last)
          c (count (.singleText m))]
      (-> (ChatResponse$Builder.)
          (.aiMessage (AiMessage. "!!!"))
          (.finishReason FinishReason/STOP)
          (.modelName "aor-model")
          (.tokenUsage (TokenUsage. (int c) (int (+ c 10)) (int (+ c 15))))
          .build))))

