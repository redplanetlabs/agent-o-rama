         (is (condition-attained? (= 2 @BLOCKED-NODES-ATOM)))
         (h/release-semaphore SEM2 1)
         ;; this means tasks have all been primed
         (is (condition-attained? (= 1 @retries-atom)))
         (h/release-semaphore SEM 1)

