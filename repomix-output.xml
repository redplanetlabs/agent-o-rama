          (let [result (aor/agent-invoke agent
                                         {:counter-name "new-counter"
                                          :operation    :increment})]
            (is (= :increment (:action result)))
            (is (= "new-counter" (:counter result)))
            (is (= 0 (:previous-value result)))
            (is (= 1 (:new-value result)))))))))
