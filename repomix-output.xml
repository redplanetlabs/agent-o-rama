               ["foo-start-fail" "start" ["e"] [{"node" "node1" "args" ["e!"]}]] 1
               ["foo-start" "start" ["c"] [{"node" "node1" "args" ["c!"]}]] 1
               ["foo-start" "start" ["d"] [{"node" "node1" "args" ["d!"]}]] 1
               ["foo-start" "start" ["e"] [{"node" "node1" "args" ["e!"]}]] 1
               ["foo-agent" nil ["c"] "c!?"] 1
               ["foo-agent" nil ["d"] "d!?"] 1
               ["foo-agent" nil ["e"] "e!?"] 1}))


       (reset! NODE-ACTION-ATOM :fail)
