        (reset! GLOBAL-ATOM 2)
        (reset! tc/RESULT-NODE-ATOM "b5")

        (bind inv (aor/agent-initiate foo 1))
        (bind trace (get-trace inv))
        (is (= "b5" (aor/agent-result foo inv)))

        (bind base-agent-task-id (.getTaskId inv))
