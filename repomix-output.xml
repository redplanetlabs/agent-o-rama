                                              "age"     (int 20)
                                              "tags"    ["x"]
                                              "contact" nil
                                              "scores"  [1.0 "NaN"]}))]
          (is (some #{"x-javaType: $.scores[1] — expected java.lang.Double"}
                    errs2)))))))

(def ^ObjectMapper OM datasets/MAPPER)

(defn ok? [x] (string? x))
(defn err? [x] (and (map? x) (contains? x :error)))
(defn ->json ^JsonNode [^String s] (.readTree OM s))
(defn to-json
  [o]
  (.writeValueAsString OM o))

