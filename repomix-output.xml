                       url (str "/agents/" (common/url-encode module-id) "/agent/" (common/url-encode agent-name) "/invocations/" task-id "-" parent-id)]
                   ($ :a {:href url
                          :className "font-mono text-sm text-blue-600 hover:underline"}
