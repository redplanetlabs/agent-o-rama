        (is (some? (get-in sub-stats [:basic-stats :node-stats])))
        (is (= 2 (count (get-in sub-stats [:basic-stats :node-stats]))))
        (is (= 150 (get-in sub-stats [:basic-stats :node-stats "sub-start" :total-time-millis])))))))
