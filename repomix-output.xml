        is-module-context? (and module-id (not agent-name))
        [collapsed? set-collapsed] (common/use-local-storage "sidebar-collapsed?" false)
        toggle-collapsed #(set-collapsed (not collapsed?))]

    ($ :div {:className (common/cn
