         (bind bar (aor/agent-client agent-manager "bar"))

         (bind reset-test!
           (fn []
             (reset! failure-appends-atom 0)
             (reset! received-atom {})))

         (bind inv (aor/agent-initiate foo :fail))
         (is (condition-attained? (= 1 @failure-appends-atom)))
         (is (condition-attained? (= 1 (count @received-atom))))
         (is (= 1
                (-> @received-atom
