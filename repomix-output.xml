(def +early-sum-accum
  (accumulator
   (fn [v]
     (term (fn [curr]
             (let [ret (+ curr v)]
               (if (> ret 10)
                 (reduced ret)
                 ret
               ))
           )))
   :init-fn
   (constantly 0)))

(def +early-sum-combiner
  (combiner
   (fn [v1 v2]
     (let [ret (+ v1 v2)]
       (if (> ret 5)
         (reduced ret)
         ret
       )))
   :init-fn
   (constantly 0)))

