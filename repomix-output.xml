       (is (re-matches #"java.lang.ArithmeticException: intentional[\s\S]*"
                       (get info "exception")))
       (is
        (re-matches
         #"Error: java.lang.ArithmeticException: intentional[\s\S]*\nPlease fix your mistakes."
