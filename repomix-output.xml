                  :info)))
       (is (= {"id"     "id2"
               "name"   "math-with-context"
               "args"   {"a" 6 "b" 3 "c" 5}
               "type"   "success"
               "result" 225}
              (-> n
                  (nth 2)
                  :info)))
       (bind info (:info (nth n 3)))
       (is (= {"id"   "id3"
