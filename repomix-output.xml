        (verify-same-nodes!
         trace
         trace2
         ["begin" "node1" "start1" "a1" "node2" "special1" "special2" "start2"
          "b1" "start3" "b2" "agg2" "b3" "agg3" "b4" "special3" "special4"
          "b5"])

        (bind special4-1 (of-input trace ["aaa" 1 2]))
        (bind agg-node (of-name trace "agg"))

        (bind finv
          (aor/agent-initiate-fork foo
