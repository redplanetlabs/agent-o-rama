                                   "zip"    {"type"    "string"
                                             "pattern" "^[0-9]{5}$"}}
                     "required"   ["street" "zip"]
                     "additionalProperties" false}}
         "type"       "object"
         "properties"
         {"id"      {"x-javaType" "java.util.UUID"}
          "name"    {"type" "string" "minLength" 1}
