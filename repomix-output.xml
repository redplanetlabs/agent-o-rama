        (bind trace2 (get-trace finv))
        (is (= "b5" (aor/agent-result foo finv)))
        (bind fagent-task-id (.getTaskId finv))
        (bind fagent-id2 (.getAgentInvokeId finv))
        (is (= fagent-task-id base-agent-task-id))
        (is (= [fagent-id1 fagent-id2]
