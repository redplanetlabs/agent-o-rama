                                           "age"     (int 20)
                                           "tags"    ["x"]
                                           "contact" nil}))]
        (is (some #{"x-javaType: $.id — expected java.util.UUID"} errs))))

    (testing "x-javaType in tuple items"
      (let [errs (msgs (datasets/validate S
                                          {"id"      (h/random-uuid7)
                                           "name"    "A"
