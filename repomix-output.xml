(defaorrecord ComparatorSpec
  [comparator :- (s/enum := :not= :< :> :<= :>=)
   value :- Object])

(defn comparator-spec-matches?
  [{:keys [comparator value]} v]
  (condp = comparator
    :=
    (= v value)

    :not=
    (not= v value)

    :<
    (< v value)

    :>
    (> v value)

    :<=
    (<= v value)

    :>=
    (>= v value)

    (throw (h/ex-info "Unknown comparator" {:comparator comparator}))))

