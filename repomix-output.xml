             ;; Left side - Snapshot Manager and Search
             ($ :div.flex.items-center.space-x-4
                ($ :span.text-sm.font-medium.text-gray-700 "Snapshot:")
                ;; --- REPLACED ---
                ($ snapshot-selector/SnapshotManager {:module-id module-id
