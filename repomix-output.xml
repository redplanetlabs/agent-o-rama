                                                      :selected-snapshot selected-snapshot-name
                                                      :on-select-snapshot set-selected-snapshot-name})

                ;; Search input field
                ($ :input.ml-4.px-3.py-1.border.border-gray-300.rounded-md.text-sm
                   {:type "text"
                    :placeholder "Search examples..."
                    :value search-string
