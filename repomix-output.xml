(deftest trace-matches-test
  (is
   (trace-matches?
    {:a {:s 1 :f 2 :emit :b}
     :b {:s 10 :f 11 :emit :c}
     :c {:s 7 :f 8}}
    {!k1 {:s ?s1 :f ?f1 :emit !k2}
     !k2 {:s ?s2 :f ?f2 :emit !k3}
     !k3 {:s ?s3 :f ?f3}}
    (m/guard
     (and (= 1 (- ?f1 ?s1))
          (= 1 (- ?f2 ?s2))
          (= 1 (- ?f3 ?s3)))
    )))
  (is
   (not
    (trace-matches?
     {:a {:s 1 :f 2 :emit :c}
      :b {:s 10 :f 11 :emit :c}
      :c {:s 7 :f 8}}
     {!k1 {:s ?s1 :f ?f1 :emit !k2}
      !k2 {:s ?s2 :f ?f2 :emit !k3}
      !k3 {:s ?s3 :f ?f3}}
     (m/guard
      (and (= 1 (- ?f1 ?s1))
           (= 1 (- ?f2 ?s2))
           (= 1 (- ?f3 ?s3)))
     ))))
  (is
   (trace-matches?
    {:a {:s 1 :f 2 :emit :b}
     :b {:s 10 :f 12 :emit :c}
     :c {:s 7 :f 10}}
    {!k1 {:s ?s1 :f ?f1 :emit !k2}
     !k2 {:s ?s2 :f ?f2 :emit !k3}
     !k3 {:s ?s3 :f ?f3}}
    (m/guard
     (and (= 1 (- ?f1 ?s1))
          (= 2 (- ?f2 ?s2))
          (= 3 (- ?f3 ?s3)))
    )))
  (is
   (not
    (trace-matches?
     {:a {:s 1 :f 2 :emit :b}
      :b {:s 10 :f 12 :emit :c}
      :c {:s 7 :f 10}}
     {!k1 {:s ?s1 :f ?f1 :emit !k2}
      !k2 {:s ?s2 :f ?f2 :emit !k3}
      !k3 {:s ?s3 :f ?f3}}
     (m/guard
      (and (= 1 (- ?f1 ?s1))
           (= 1 (- ?f2 ?s2))
           (= 3 (- ?f3 ?s3)))
     ))))
  (is
   (trace-matches?
    [1 2 3 1 2 3]
    [!id1 !id2 !id3 !a1 !a2 !a3]))
  (is
   (trace-matches?
    [1 2 3 4 5 6]
    [!id1 !id2 !id3 !a1 !a2 !a3]))
  (is
   (not
    (trace-matches?
     [1 2 1 4 5 6]
     [!id1 !id2 !id3 !a1 !a2 !a3])))
  (is
   (trace-matches?
    [1 2 3 4 5 6]
    [!id1-1 !id1-2 !id1-3 !id1 !id2 !id3]))
  (is
   (not
    (trace-matches?
     [1 2 1 4 5 6]
     [!id1-1 !id1-2 !id1-3 !id1 !id2 !id3])))
)

